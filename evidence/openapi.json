    "title": "Study Tasks API",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  }
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ]
            }
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "issues",
          "requestId"
        ]
      },
      "Credentials": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72
          }
        },
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "LoginCredentials": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Credentials"
          },
          {
            "type": "object",
            "properties": {
              "password": {
                "type": "string",
                "minLength": 1,
                "maxLength": 72
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "userId": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "in-progress",
              "done"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "createdAt": {
            "type": "number"
          },
          "updatedAt": {
            "type": "number"
          },
          "completedAt": {
            "type": "number",
            "nullable": true
          },
          "deletedAt": {
            "type": "number",
            "nullable": true
          },
          "attachment": {
            "type": "string",
            "nullable": true
          },
          "dueDate": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "userId",
          "title",
          "status",
          "priority",
          "createdAt",
          "updatedAt",
          "completedAt",
          "deletedAt",
          "attachment",
          "dueDate"
        ]
      },
      "TaskInput": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "in-progress",
              "done"
            ],
            "default": "todo"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "default": "medium"
          },
          "dueDate": {
            "type": "string",
            "nullable": true,
            "format": "date",
            "default": null
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
