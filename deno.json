{
  "tasks": {
    "dev": "deno run -A --unstable-kv --unstable-cron --env-file=.env.example --env-file=.env --watch src/main.ts",
    "start": "deno run -A --unstable-kv --unstable-cron --env-file=.env.example --env-file=.env src/main.ts",
    "test": "deno test -A --unstable-kv --unstable-cron tests/",
    "check": "deno check --unstable-kv --unstable-cron src/*.ts scripts/*.ts tests/*.ts drizzle.config.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "ui:install": "cd ui && deno install",
    "ui:dev": "cd ui && deno task dev",
    "start:production": "deno run -A --unstable-kv --unstable-cron --env-file=.env.production src/main.ts",
    "test:env": "deno test -A --unstable-kv --unstable-cron --env-file=.env.test tests/",
    "db:generate": "deno run -A npm:drizzle-kit@0.31.8 generate",
    "db:migrate": "deno run -A --env-file=.env.example --env-file=.env scripts/migrate.ts",
    "seed": "deno run -A --env-file=.env.example --env-file=.env scripts/seed.ts",
    "benchmark": "deno run -A scripts/benchmark.ts",
    "evidence": "deno run -A --unstable-kv --unstable-cron scripts/evidence.ts",
    "docker:verify": "deno run -A scripts/docker_verify.ts",
    "cron:verify": "deno run -A --unstable-cron scripts/cron_probe.ts"
  },
  "imports": {
    "hono": "npm:hono@4.11.4",
    "zod": "npm:zod@4.3.5",
    "bcryptjs": "npm:bcryptjs@^3",
    "drizzle-orm": "npm:drizzle-orm@0.44.7",
    "drizzle-orm/libsql": "npm:drizzle-orm@0.44.7/libsql",
    "drizzle-orm/sqlite-core": "npm:drizzle-orm@0.44.7/sqlite-core",
    "@libsql/client": "npm:@libsql/client@^0.15",
    "@std/assert": "jsr:@std/assert@^1",
    "drizzle-kit": "npm:drizzle-kit@0.31.8",
    "drizzle-orm/libsql/migrator": "npm:drizzle-orm@0.44.7/libsql/migrator",
    "@hono/zod-openapi": "npm:@hono/zod-openapi@1.1.5",
    "jose": "npm:jose@6.1.3",
    "drizzle-orm/logger": "npm:drizzle-orm@0.44.7/logger",
    "@hono/swagger-ui": "npm:@hono/swagger-ui@0.5.2",
    "hono/utils/http-status": "npm:hono@4.11.4/utils/http-status"
  },
  "fmt": {
    "lineWidth": 90,
    "exclude": [
      "drizzle/meta",
      "evidence"
    ]
  },
  "lint": {
    "exclude": [
      "drizzle/meta"
    ]
  },
  "nodeModulesDir": "auto",
  "unstable": [
    "kv",
    "cron"
  ],
  "deploy": {
    "runtime": {
      "type": "dynamic",
      "entrypoint": "./src/main.ts"
    }
  }
}
